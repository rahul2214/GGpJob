# ==============================================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to .env or .env.local and fill in the values for your environment.
# ==============================================================================================

# ----------------------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN
# ----------------------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# ----------------------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & AUTH (REQUIRED)
# ----------------------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Connection Pooling (Port 6543) via Supavisor (Recommended for high concurrency)
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# ----------------------------------------------------------------------------------------------
# 3. HIGH-CONCURRENCY SCALABILITY (HIGHLY RECOMMENDED FOR >1,000 CONCURRENT USERS)
# ----------------------------------------------------------------------------------------------
# Supabase JWT Secret: Enables local cryptographic token verification in auth-server.ts.
# Eliminates thousands of HTTP roundtrips to Supabase Auth API under heavy traffic.
# Where to find: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Upstash Redis: Enables distributed L2 caching across serverless instances and multiple containers.
# If omitted, system automatically falls back to high-speed in-memory LRU cache.
# Where to find: https://console.upstash.com -> Create Redis Database -> REST API
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# Read Replica URL: Routes heavy read traffic (jobs, taxonomy, filters) away from the primary DB.
# If omitted, system automatically queries the primary database.
SUPABASE_READ_REPLICA_URL=https://your-read-replica.supabase.co

# ----------------------------------------------------------------------------------------------
# 4. STORAGE (CLOUDFLARE R2 / S3)
# ----------------------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ----------------------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS
# ----------------------------------------------------------------------------------------------
# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxx

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# ----------------------------------------------------------------------------------------------
# 6. EMAILS & NOTIFICATIONS
# ----------------------------------------------------------------------------------------------
# Brevo (Sendinblue)
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER_EMAIL=support@yourdomain.com
BREVO_SENDER_NAME="Job Portal Support"

# Resend (Optional alternative)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=support@yourdomain.com

# ----------------------------------------------------------------------------------------------
# 7. AI & RESUME ENHANCEMENT
# ----------------------------------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxx
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
